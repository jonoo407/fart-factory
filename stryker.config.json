{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing per Quality v2 Fake-Test Gate (Just et al. FSE 2014). Runs Stryker against pure-logic modules only (DOM/audio surfaces are E2E-tested).",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/scoring/**/*.ts",
    "src/state/**/*.ts",
    "src/audio/mute.ts",
    "src/ui/haptics.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "timeoutMS": 60000,
  "concurrency": 4
}
