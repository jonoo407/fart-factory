{
  "name": "fart-factory",
  "private": true,
  "version": "2.0.0-overhaul",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/ tests/",
    "mutation": "stryker run",
    "lighthouse": "lighthouse http://localhost:5173/fart-factory/ --form-factor=mobile --only-categories=performance,accessibility --chrome-flags=\"--headless=new\" --output=json --output-path=.session/lighthouse.json --quiet",
    "sfx:generate": "tsx scripts/generate-sfx.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.48.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^2.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^10.3.0",
    "jsdom": "^25.0.0",
    "lighthouse": "^13.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
